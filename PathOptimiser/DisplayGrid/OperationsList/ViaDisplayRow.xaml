<UserControl x:Class="PathOptimiser.DisplayGridRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:PathOptimiser" 
             d:DataContext="{d:DesignInstance Type=local:DisplayGridRow}"
             mc:Ignorable="d"  d:DesignWidth="900" MouseEnter="chkActivated_MouseEnter" BorderThickness="0,0,0,0.5" BorderBrush="Gray" d:Background="White">
    <UserControl.Resources>
        <local:IndexConverter x:Key="IndexConverter"/>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label x:Name="lblNumber" MinWidth="30" Foreground="Gray" FontWeight="Light" Content="{Binding RelativeSource={RelativeSource AncestorType=local:DisplayGridRow}, Converter={StaticResource IndexConverter}}"/>
                            <!-- Rounded border with ContentPresenter inside -->
                            <Border x:Name="CheckBoxBorder"
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="2">
                                <Border x:Name="InsideBorder"
                                Grid.Column="0"
                                Width="12"
                                Height="12"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#0078D4"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="2">

                                    <!-- The ContentPresenter will show the check mark -->
                                    <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                                </Border>
                            </Border>

                            <!-- Actual content text -->
                            <ContentPresenter x:Name="textPresenter"
                                          Grid.Column="2"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"
                                          Margin="5,0,0,0"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InsideBorder" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="InsideBorder" Property="BorderThickness" Value="0"/>
                            </Trigger>

                            <Trigger  Property="IsMouseOver" Value="True">
                                <Setter TargetName="InsideBorder" Property="Background" Value="#E6E6E6"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel LastChildFill="True" Margin="0,0,10,0">
            <CheckBox x:Name="chkActivated" DockPanel.Dock="Left" Margin="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="" IsChecked="{Binding Path=Included, Mode=TwoWay}" IsEnabled="{Binding Path=CanBeActive,Mode=OneWay}" />

            <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="auto">
                    
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="NameCol"/>
                    <ColumnDefinition Width="1*"/> <!--This allows the name to stay left-centred while also sharing the minimum width-->

                    <ColumnDefinition Width="auto" SharedSizeGroup="CNTCol"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="SpeedCol"/>
                </Grid.ColumnDefinitions>

                <Label x:Name="lblName" d:Content="[Via Name]" VerticalAlignment="Center" Cursor="Hand" MouseDown="lblName_MouseDown" Margin="0,0,10,0"/>

                    
                <ScrollViewer HorizontalScrollBarVisibility="Auto" Grid.Column="1" VerticalScrollBarVisibility="Hidden" d:HorizontalScrollBarVisibility="Visible">
                    <ScrollViewer.Resources>
                        <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">15</sys:Double>
                    </ScrollViewer.Resources>

                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <StackPanel x:Name="stkCollisionReport" HorizontalAlignment="Center" Orientation="Horizontal" Width="auto" Visibility="Collapsed" d:Visibility="Visible">
                        <Label Content="Final Clearance:" VerticalAlignment="Center" Foreground="DarkRed"/>
                            <Label x:Name="lblFinalClearance" VerticalAlignment="Center" HorizontalContentAlignment="Left" d:Content="[value]" Foreground="DarkRed"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="stkAcceptedClearance" HorizontalAlignment="Center" Orientation="Horizontal" Width="auto" Visibility="Collapsed" d:Visibility="Visible">
                        <Label Content="Permissable Clearance:" VerticalAlignment="Center"/>
                        <Label x:Name="lblAcceptedClearance" VerticalAlignment="Center" HorizontalContentAlignment="Left" d:Content="[value]"/>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                    

                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal"  Width="auto" Grid.Column="2" Margin="5,0,0,0">
                    <Label Content="CNT:" VerticalAlignment="Center"/>
                    <Label x:Name="lblCnt" VerticalAlignment="Center" HorizontalContentAlignment="Left" d:Content="[value]"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Width="auto" Grid.Column="3" Margin="5,0,0,0">
                    <Label Content="Speed:" VerticalAlignment="Center"/>
                    <Label x:Name="lblSpeed"  VerticalAlignment="Center" HorizontalContentAlignment="Left" d:Content="[value]"/>
                </StackPanel>

            </Grid>
            
        </DockPanel>
    </Grid>
</UserControl>
