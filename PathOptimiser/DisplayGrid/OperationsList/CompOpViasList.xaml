<UserControl x:Name="CollectionOperationDisplay" x:Class="PathOptimiser.DisplayGrid.OperationsList.CollectionOperationsDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PathOptimiser.DisplayGrid.OperationsList"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" d:Background="white" DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}">

    <StackPanel Orientation="Vertical">
        <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,20,0">
            
        <Label x:Name="lblCollectionName" d:Content="Collection Name" VerticalAlignment="Center" BorderBrush="Gray" BorderThickness="1" Cursor="Hand" MouseDown="lblCollectionName_MouseDown">
                    <Label.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove" Click="RemoveButtonClick"/>
                        </ContextMenu>

                    </Label.ContextMenu>
                </Label>
			
            <Border x:Name="ctrlStatusBorder" Margin="6,0,0,0" CornerRadius="12" BorderThickness="1" d:Background="Green" ClipToBounds="True" VerticalAlignment="Center">
            <Label x:Name="lblStatus" d:Content="Status"/>
            </Border>
            <Label x:Name="lblTime" d:Content="Time Info" VerticalContentAlignment="Center"/>

                <Border x:Name="borderReset" Margin="6,0,0,0" CornerRadius="6" BorderThickness="1" d:Background="LightBlue" ClipToBounds="True" VerticalAlignment="Center">
                <Button x:Name="btnUndo" Content="Revert" Click="btnReset_Click"/>
                </Border>
            </StackPanel>
        <!--StackPanel Orientation="Vertical" HorizontalAlignment="Right"-->

            <Expander Header="Options" IsExpanded="True" ExpandDirection="Left" HorizontalAlignment="Right" >
                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,3,0" VerticalAlignment="Stretch">
                    <WrapPanel Orientation="Horizontal" Background="#FFEBF4FF">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,5,0">
                        <Label Content="required clearance/mm:" FontSize="11" FontWeight="Bold" HorizontalContentAlignment="Right" VerticalContentAlignment="center" Margin="2,2,0,2" Padding="2,2,1,2"/>
                <TextBox x:Name="txtClearance"  MinWidth="30" Text="{Binding Data.Clearance}" VerticalAlignment="Center"  HorizontalContentAlignment="Center" VerticalContentAlignment="center" Margin="3" />
                </StackPanel>
                <Border  BorderThickness="0.5" BorderBrush="Gray" Margin="3,2,5,2">
                            <CheckBox x:Name="chkIgnoreCollisions" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="2"  FontSize="11" Content="Ignore Existing Collisions" IsChecked="{Binding Data.IgnoreCollisions, Mode=TwoWay}" Cursor="Help">
                                <CheckBox.ToolTip>
                                    <TextBlock FontSize="15">
Stops the optimiser attempting to clear collisions that were already present in the path
<LineBreak/>
Required for pick/drop paths
<LineBreak/>
The gun closing for a weld will always be ignored, regardless of this setting
                                    </TextBlock>
                                </CheckBox.ToolTip>
                            </CheckBox>
                </Border>
                <Border  BorderThickness="0.5" BorderBrush="Gray" Margin="3,2,5,2">
                            <CheckBox x:Name="chkIgnoreNearMiss" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="2"  FontSize="11" Content="Ignore Existing Near Misses" IsChecked="{Binding Data.IgnoreNearMisses, Mode=TwoWay}" Cursor="Help">
                                <CheckBox.ToolTip>
                                    <TextBlock FontSize="15">
    Stops the optimiser attempting to clear near-misses that were already present in the path
    <LineBreak/>
    Required for pick/drop paths
    <LineBreak/>
    Use this for near-misses that are unavoidable
                                    </TextBlock>
                                </CheckBox.ToolTip>
                            </CheckBox>
                        </Border>
                <Border  BorderThickness="0.5" BorderBrush="Gray" Margin="3,2,5,2">
                    <CheckBox x:Name="chkSetMaxSpeeds" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="2"  FontSize="11" Content="Use Max Speeds" IsChecked="{Binding Data.SetToMax, Mode=TwoWay}" Cursor="Help">
                        <CheckBox.ToolTip>
                                <TextBlock FontSize="15">
                            Recommended to leave this checked
                            <LineBreak/>
                            When checked, the optimiser will step down from max speeds and CNTs
                            <LineBreak/>
                            When unchecked, steps down from the current speeds/CNTs
                            </TextBlock>
                        </CheckBox.ToolTip>
                        </CheckBox>
                    </Border>
                    </WrapPanel>
            </Border>
                </Expander>
            <!--/StackPanel-->
        </DockPanel>
        <Expander IsExpanded="True" BorderThickness="1" BorderBrush="LightGray" Padding="3" Margin="2,5,2,3" Header="Vias">
          
            <StackPanel x:Name="stkRows" Orientation="Vertical" Margin="10,0,0,0"/>
        </Expander>
    </StackPanel>
</UserControl>
