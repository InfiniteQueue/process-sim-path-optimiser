<UserControl x:Class="PathOptimiser.DisplayGrid.DebugEnvelopeDisplay.EnvelopeDisplayGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PathOptimiser.DisplayGrid.DebugEnvelopeDisplay"
             mc:Ignorable="d" 
             d:Background="white"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
        <Label Content="Detected Collision Display:" Padding="1"/>
        <Label x:Name="lblOperationName" Padding="1" Margin="8,0,0,0"/>
        </StackPanel>
        <local:CollisionTimelineControl Height="30" x:Name="ctrlTimeLine" Margin="15,0,15,0"/>
        <StackPanel Orientation="Vertical" x:Name="stkRows">
            
    </StackPanel>
    </StackPanel>
</UserControl>
