<SMC_Form_Library:SMC_Form_WPF
    x:Class="PathOptimiser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:SMC_Form_Library="clr-namespace:SMC_Form_Library;assembly=SMC_Form_Library"
    xmlns:DisplayGrid="clr-namespace:PathOptimiser.DisplayGrid"
    xmlns:EnvelopeDisplay="clr-namespace:PathOptimiser.DisplayGrid.DebugEnvelopeDisplay"
    xmlns:debug="clr-namespace:PathOptimiser.Debugging"
    Width="800"
    Height="450"
    mc:Ignorable="d"
    Title="Path Optimiser"
    Background="GhostWhite"
    Topmost="True"
    MinWidth="700"
    StatusVisible="Visible">
    <Window.Resources>
        <debug:DebuggerAttachedConverter x:Key="DebuggerAttachedConverter"/>

        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
								CornerRadius="5"
                                Margin="2"
                                Padding="2.5"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center"
											VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>

            <!-- Optional: Add hover effects -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightBlue"/>
                    <Setter Property="BorderBrush" Value="SteelBlue"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="DodgerBlue"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="Background" Value="DarkGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="GhostWhite">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="ctrlScrollViewer" Background="GhostWhite">
            <StackPanel x:Name="stkDisplayGrids" Margin="5">
                <DisplayGrid:AllOperationsDisplay x:Name="ctrlAllOperations"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" HorizontalAlignment="Left" Orientation="Horizontal">
            <CheckBox x:Name="chkIgnoreNearMisses" Content="Ignore existing near misses" IsChecked="True" VerticalContentAlignment="Center" Margin="5" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal" x:Name="stkButtons" Background="GhostWhite">
            <Button
                x:Name="btnDebug"
                Visibility="Visible"
                HorizontalAlignment="Right"
                Content="Debug"
                Padding="2" 
                Click="btnDebug_Click"/>
                <Button
                x:Name="btnAddSelected"
                HorizontalAlignment="Right"
                Click="btnAddSelected_Click"
                Content="Set Selected Paths"
                Padding="2" />
                <Grid>
                <Button
                x:Name="btnRun"
                HorizontalAlignment="Right"
                Click="Run"
                Content="Run"/>
            </Grid>
            <Button x:Name="btnCancel"
                    IsEnabled="False"
        HorizontalAlignment="Left"
        Click="Cancel_Click"
        Content="Cancel"
        Padding="2"/>
        </StackPanel>
        <Border BorderThickness="1" BorderBrush="Black" Grid.Row="1">
        <EnvelopeDisplay:EnvelopeDisplayGrid x:Name="ctrlEnvelopeDisplay" Visibility="Collapsed"/>
            </Border>
    </Grid>
    <SMC_Form_Library:SMC_Form_WPF.ButtonPanel>
        <StackPanel MinHeight="20" Orientation="Horizontal" Background="GhostWhite"/>
    </SMC_Form_Library:SMC_Form_WPF.ButtonPanel>
</SMC_Form_Library:SMC_Form_WPF>